{
  // 1. Activar formateo automático al guardar
  "editor.formatOnSave": true,

  // 2. Configurar Biome como formateador por defecto para TS y HTML
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[html]": {
    "editor.defaultFormatter": "biomejs.biome"
  },

  // 3. Configurar Stylelint como formateador para CSS
  "[css]": {
    "editor.defaultFormatter": "stylelint.vscode-stylelint"
  },

  // 4. Ejecutar correcciones automáticas de Biome y Stylelint al guardar
  "editor.codeActionsOnSave": {
// Nuevas acciones oficiales de Biome
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit",
    
    // Acción oficial de Stylelint para ordenar CSS
    "source.fixAll.stylelint": "explicit"
  }
}